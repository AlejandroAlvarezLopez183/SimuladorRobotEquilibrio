<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ComboBox?> <?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.shape.Rectangle?> <BorderPane prefHeight="768.0" prefWidth="1024.0" stylesheets="@../styles/dark_theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uv.simuladoraleexplorador.main.ui.MainController">

    <top>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <MenuBar>
                    <menus>
                        <Menu mnemonicParsing="false" text="Archivo">
                            <items>
                                <MenuItem mnemonicParsing="false" text="Importar CAD (.obj)" onAction="#handleImportarModelo" />
                                <MenuItem mnemonicParsing="false" text="Salir" />
                            </items>
                        </Menu>
                        <Menu mnemonicParsing="false" text="Simulación">
                            <items>
                                <MenuItem mnemonicParsing="false" text="Iniciar" onAction="#handleSimPlay" />
                                <MenuItem mnemonicParsing="false" text="Pausar" onAction="#handleSimPause" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>

                <ToolBar prefHeight="40.0" prefWidth="200.0">
                    <items>
                        <Button fx:id="btn2D" mnemonicParsing="false" onAction="#handleSwitchTo2D" text="Vista 2D" />
                        <Button fx:id="btn3D" mnemonicParsing="false" onAction="#handleSwitchTo3D" text="Vista 3D" />

                        <Separator orientation="VERTICAL" />

                        <Label text="Snap:" textFill="#aaaaaa">
                            <font><Font size="10.0"/></font>
                        </Label>
                        <ComboBox fx:id="cmbSnap" prefWidth="80.0" />

                        <Separator orientation="VERTICAL" />

                        <Label text="Rotar 90°:" textFill="#aaaaaa" />
                        <Button mnemonicParsing="false" onAction="#handleRotarX" text="X" style="-fx-font-weight: bold; -fx-base: #444;" />
                        <Button mnemonicParsing="false" onAction="#handleRotarY" text="Y" style="-fx-font-weight: bold; -fx-base: #444;" />
                        <Button mnemonicParsing="false" onAction="#handleRotarZ" text="Z" style="-fx-font-weight: bold; -fx-base: #444;" />

                        <Separator orientation="VERTICAL" />

                        <Button mnemonicParsing="false" onAction="#handleResetSim" text="Resetear Posición" />

                        <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#handleDeleteSelected"
                                prefWidth="200.0" text="ELIMINAR"
                                style="-fx-base: #722; -fx-text-fill: white; -fx-font-weight: bold;">
                        </Button>

                        <Separator orientation="VERTICAL" />

                        <ToggleButton fx:id="btnGizmos" mnemonicParsing="false" selected="true"
                                      text="Ver Controles" onAction="#handleToggleGizmos" />

                        <ToggleButton fx:id="btnDebug" mnemonicParsing="false" selected="true"
                                      text="Ver Límites" onAction="#handleToggleDebug" />

                        <Button text="UNIR (A+B)" onAction="#handleGroupObjects" style="-fx-base: #4a4;" />
                    </items>
                </ToolBar>
            </children>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="contentPane" styleClass="workspace-background" BorderPane.alignment="CENTER">
            <children>
                <javafx.scene.layout.Pane fx:id="selectionOverlay" pickOnBounds="false">
                    <children>
                        <javafx.scene.shape.Rectangle fx:id="selectionRect"
                                                      fill="#1e90ff40"
                                                      stroke="#1e90ff"
                                                      strokeType="INSIDE"
                                                      visible="false"
                                                      mouseTransparent="true" />
                    </children>
                </javafx.scene.layout.Pane>
            </children>
        </StackPane>
    </center>

    <right>
        <VBox fx:id="inspectorContainer" prefWidth="280.0" spacing="10.0" style="-fx-background-color: #252525; -fx-border-color: #151515; -fx-border-width: 0 0 0 1;" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-padding: 10; -fx-font-weight: bold; -fx-text-fill: #e0e0e0;" text="INSPECTOR DE OBJETO" />

                <Accordion>
                    <panes>
                        <TitledPane animated="true" text="Propiedades Físicas">
                            <content>
                                <VBox spacing="10.0" style="-fx-background-color: #2b2b2b;">
                                    <children>
                                        <Label text="Masa (Kg)" textFill="#aaaaaa" />
                                        <TextField fx:id="txtMasa" promptText="Ej. 10.0" text="10.0" />
                                        <Button mnemonicParsing="false" onAction="#handleUpdatePhysics" prefWidth="200.0" text="Aplicar Masa" />

                                        <Region prefHeight="10.0" />

                                        <Label text="Resistencia Aire (Drag)" textFill="#aaaaaa" />
                                        <Slider fx:id="sliderDrag" blockIncrement="0.1" max="1.0" value="0.0" />
                                        <Label text="(0 = Vacío, 1 = Paracaídas)" textFill="#666666">
                                            <font>
                                                <Font size="10.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>

                        <TitledPane animated="true" text="Transformación">
                            <content>
                                <VBox spacing="5.0" style="-fx-background-color: #2b2b2b;">
                                    <children>
                                        <Label text="Posición Y (Altura):" textFill="#aaaaaa" />
                                        <Label fx:id="lblAltura" text="0.00 m" textFill="WHITE" />

                                        <Label text="Rotación X" textFill="#aaaaaa" />
                                        <Slider fx:id="sliderRotX" max="360" />
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>
                    </panes>
                </Accordion>

                <Region VBox.vgrow="ALWAYS" />

                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Button onAction="#handleResetSim" prefHeight="40.0" prefWidth="200.0" style="-fx-base: #aa3333; -fx-font-weight: bold;" text="REINICIAR SIMULACIÓN" textFill="WHITE" />
                        <Region prefHeight="20.0" />
                    </children>
                </VBox>

            </children>
        </VBox>
    </right>

</BorderPane>